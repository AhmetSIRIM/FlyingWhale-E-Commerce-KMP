{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  // Renovate's recommended preset. By extending it, every supported package manager is activated
  // by scanning files in the repo: the Gradle version catalog and build scripts, GitHub Actions
  // workflows and composite actions, Dockerfiles, npm, and so on. One line covers what would
  // otherwise need a separate ecosystem block per surface.
  "extends": ["config:recommended"],
  // Renovate creates the label if it does not exist and applies it to every PR it opens.
  "labels": ["dependencies"],
  // A window, not an instant. Renovate checks a repository every few hours rather than on a clock
  // tick, and it has no minute granularity, so a schedule narrower than that interval is skipped
  // more often than it is hit. Four hours from 03:00 keeps the intended early-Monday slot while
  // staying wide enough for a check to land inside it.
  "schedule": ["after 3am and before 7am on monday"],
  // Local time for the schedule above; Renovate falls back to UTC if this is absent.
  "timezone": "Europe/Istanbul",
  "prConcurrentLimit": 5,
  // Grouping shape mirrors the one the Dependabot configurations in the fleet
  // settled on: a quiet week should cost one review, not six.
  //
  // Two axes decide which PR an update lands in. Update type comes first:
  // minor and patch collapse into a single PR, while a major keeps a PR of its
  // own, because a breaking change earns a read that a bundle would bury.
  // Manager comes second: a library bump changes how the product behaves and an
  // action bump changes how CI behaves, so they stay in separate PRs and a red
  // check keeps pointing at one of the two rather than both.
  //
  // The family rules below carry majors only. For minor and patch they would be
  // redundant: everything already travels in one PR, so lockstep across a
  // family holds for free. A major is where lockstep has to be stated, since
  // the Kotlin plugins, the Compose plugin and the Ktor artifacts each break if
  // one moves without its siblings.
  //
  // The cost of this shape, accepted knowingly: one failing dependency reddens
  // the whole grouped PR and the healthy updates inside it cannot merge without
  // it. When that happens the offender gets pinned or ignored deliberately,
  // which is a better prompt than six PRs nobody reads.
  //
  // The update-type sets are disjoint, so rule order carries no meaning here
  // and a later rule cannot silently capture an earlier one.
  "packageRules": [
    {
      "matchManagers": ["gradle"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "gradle-minor-and-patch"
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "actions-minor-and-patch"
    },
    {
      // Kotlin core (compiler, plugins, kotlin-test). The (\\.|:|$) tail keeps kotlinx and
      // kotlin-wrappers out of this group.
      "matchPackageNames": ["/^org\\.jetbrains\\.kotlin(\\.|:|$)/"],
      "matchUpdateTypes": ["major"],
      "groupName": "kotlin"
    },
    {
      "matchPackageNames": ["/^org\\.jetbrains\\.compose/"],
      "matchUpdateTypes": ["major"],
      "groupName": "compose-multiplatform"
    },
    {
      "matchPackageNames": ["/^io\\.ktor/"],
      "matchUpdateTypes": ["major"],
      "groupName": "ktor"
    },
    {
      "matchPackageNames": ["/^androidx\\./"],
      "matchUpdateTypes": ["major"],
      "groupName": "androidx"
    },
    {
      "matchPackageNames": ["/^io\\.gitlab\\.arturbosch\\.detekt/"],
      "matchUpdateTypes": ["major"],
      "groupName": "detekt"
    },
    {
      "matchPackageNames": ["/^com\\.android\\./"],
      "matchUpdateTypes": ["major"],
      "groupName": "agp"
    }
  ],
  "vulnerabilityAlerts": {
    // Empty schedule lifts the weekly cap so vulnerability fixes can land any time.
    "labels": ["dependencies", "security"],
    "schedule": []
  }
}
